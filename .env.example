# ── Scheduler ─────────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=6
MIN_RELEVANCE_SCORE=70
MAX_APPLICATIONS_PER_CYCLE=5
DELAY_BETWEEN_APPLICATIONS=90
DRY_RUN=true

# ── Base de données ───────────────────────────────────────
DATABASE_PATH=data/jobhunt.db

# ── LLM (optionnel) ───────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── SMTP (envoi email) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPORT_TO=

# ── Profil candidat ───────────────────────────────────────
CANDIDATE_NAME=Nicolas Roger
CANDIDATE_LOCATION=Paris
CANDIDATE_PROFILE=Communication · Data · E-Commerce

# ── Recherche d'offres ────────────────────────────────────
JOB_BOARDS=wttj,indeed,linkedin
JOB_KEYWORDS=communication,data,e-commerce
JOB_LOCATION=Paris
